<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ZEYUSecurityLab" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/zeyu_primary</item>
        <item name="colorOnPrimary">@color/zeyu_on_primary</item>
        <item name="colorSecondary">@color/zeyu_secondary</item>
        <item name="colorOnSecondary">@color/zeyu_on_primary</item>
        <item name="colorSurface">@color/zeyu_surface</item>
        <item name="colorOnSurface">@color/zeyu_text_primary</item>
        <item name="colorError">@color/zeyu_error</item>

        <!-- System Bar Colors -->
        <item name="android:windowBackground">@color/zeyu_background</item>
        <item name="android:statusBarColor">@color/zeyu_background</item>
        <item name="android:navigationBarColor">@color/zeyu_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Typography Defaults -->
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/zeyu_text_primary</item>
        <item name="android:textColorPrimary">@color/zeyu_text_primary</item>
        <item name="android:textColorSecondary">@color/zeyu_text_secondary</item>

        <!-- Default Checkbox and Radio Tints -->
        <item name="android:buttonTint">@color/zeyu_primary</item>
    </style>

</resources>
