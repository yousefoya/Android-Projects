<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZEYUSecurityLab">

        <!-- Launcher Screen: Profile Activity ("ZEYU Agent ID") -->
        <activity
            android:name=".ProfileActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ZEYUSecurityLab"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registration Screen: Sign-Up Activity ("Join ZEYU") -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:label="@string/signup_screen_title"
            android:theme="@style/Theme.ZEYUSecurityLab"
            android:windowSoftInputMode="adjustResize" />

        <!-- Optional Main Activity entry for compatibility -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.ZEYUSecurityLab" />

    </application>

</manifest>
